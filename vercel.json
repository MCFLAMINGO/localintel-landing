{
  "rewrites": [
    {
      "source": "/zip/:code",
      "destination": "/zip/:code.html"
    },
    {
      "source": "/neighborhood/:slug",
      "destination": "/neighborhood/:slug.html"
    },
    {
      "source": "/rfq/:token",
      "destination": "/rfq.html"
    }
  ],
  "redirects": [
    {
      "source": "/claim",
      "destination": "/claim.html",
      "permanent": false
    },
    {
      "source": "/inbox",
      "destination": "/inbox.html",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/merchant",
      "destination": "/merchant.html",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/quote",
      "destination": "/quote.html",
      "permanent": false
    }
  ]
}